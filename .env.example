# =============================================================================
# Meldex AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Obtain from your Postgres provider (Supabase, Neon, Railway, self-hosted, …)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# NextAuth / Auth.js
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate a secure value
# NEXTAUTH_URL: full URL of your deployment (no trailing slash)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OAuth — GitHub
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
# -----------------------------------------------------------------------------
GITHUB_ID=
GITHUB_SECRET=

# -----------------------------------------------------------------------------
# OAuth — Google
# Create credentials at https://console.cloud.google.com/
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI / Ollama
# Default local Ollama endpoint. Change if Ollama runs on a remote host.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# Default model loaded in the chat and agent UI
DEFAULT_MODEL=qwen3-coder:30b

# -----------------------------------------------------------------------------
# Brain Provider Router
# Controls which AI backend Meldex uses for chat and agent tasks.
# Options: local_ollama | openrouter | custom_openai_compatible
# Default (if unset): local_ollama
# -----------------------------------------------------------------------------
MELDEX_BRAIN_PROVIDER=local_ollama

# --- OpenRouter (Cloud Test Brain) ---
# Sign up at https://openrouter.ai/ to get a free API key.
# Free-tier model: qwen/qwen3-coder:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-coder:free

# --- Custom OpenAI-compatible endpoint ---
# Compatible with Together AI, Fireworks, vLLM, LM Studio, etc.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# -----------------------------------------------------------------------------
# Cloudflare R2 Object Storage
# Create a bucket at https://dash.cloudflare.com/ → R2
# R2_PUBLIC_URL: public domain for the bucket (or R2.dev subdomain)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meldex-storage
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Billing — Stripe (optional, for paid plans)
# -----------------------------------------------------------------------------
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
