# =============================================================================
# Meldex AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Obtain from your Postgres provider (Supabase, Neon, Railway, self-hosted, …)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# NextAuth / Auth.js
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate a secure value
# NEXTAUTH_URL: full URL of your deployment (no trailing slash)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OAuth — GitHub
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
# -----------------------------------------------------------------------------
GITHUB_ID=
GITHUB_SECRET=

# -----------------------------------------------------------------------------
# OAuth — Google
# Create credentials at https://console.cloud.google.com/
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI / Ollama
# Default local Ollama endpoint. Change if Ollama runs on a remote host.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# Default model loaded in the chat and agent UI
DEFAULT_MODEL=qwen3-coder:30b

# Optional: external AI provider keys
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Billing — Stripe (optional, for paid plans)
# -----------------------------------------------------------------------------
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
