# =============================================================================
# Meldex AI — Production Environment Template
# Copy to .env.production on your AWS EC2 server and fill in all values.
# NEVER commit this file to git.
# Set permissions: chmod 600 .env.production
# =============================================================================

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The deploy-aws.sh script fills this in automatically.
DATABASE_URL=postgresql://meldex_user:STRONG_PASSWORD@localhost:5432/meldex

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_32
NEXTAUTH_URL=https://YOUR_DOMAIN

# ── OpenRouter (Cloud AI Brain) ───────────────────────────────────────────────
MELDEX_BRAIN_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-coder:free

# ── Ollama (optional local fallback) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen3-coder:30b

# ── Cloudflare R2 Object Storage ──────────────────────────────────────────────
# Dashboard: https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=d9f914a2dd73a2749af55b82681b2853
R2_ACCESS_KEY_ID=bca6d0ae2f7055d9a64813930dcc771e
R2_SECRET_ACCESS_KEY=2789d8e3b9de69dd94a6f5c27992875db3bc5432286d9d0d0b59bbcf56b03808
R2_BUCKET=meldex
R2_PUBLIC_URL=https://pub-2062c32f77914e9580d0f132baa6c38b.r2.dev

# ── OAuth — Google ────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ → Credentials
# Callback: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
# Callback: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
