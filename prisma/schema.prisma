generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DEPLOYING
  FAILED
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum AgentRole {
  PLANNER
  ARCHITECT
  CODER
  TESTER
  REVIEWER
  DEVOPS
}

enum ModelProvider {
  OLLAMA
  OPENAI
  DEEPSEEK
  ANTHROPIC
  OPENROUTER
  CUSTOM_OPENAI_COMPATIBLE
}

enum BillingStatus {
  FREE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?
  role           Role            @default(USER)
  authProvider   String          @default("email")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  conversations  Conversation[]
  tasks          Task[]
  usageLogs      UsageLog[]
  billing        Billing?
  modelConfigs   ModelConfig[]
  auditLogs      AuditLog[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  email      String
  token      String   @unique
  expires    DateTime

  @@unique([email, token])
}

model Project {
  id             String          @id @default(cuid())
  userId         String
  name           String
  slug           String
  description    String?
  template       String?
  repositoryUrl  String?
  workspacePath  String
  status         ProjectStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  files          File[]
  conversations  Conversation[]
  tasks          Task[]
  executions     Execution[]
  usageLogs      UsageLog[]

  @@unique([userId, slug])
  @@index([userId, status])
}

model File {
  id          String   @id @default(cuid())
  projectId   String
  path        String
  contentHash String?
  language    String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  model          String?
  tokenCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Task {
  id           String        @id @default(cuid())
  userId       String
  projectId    String?
  title        String
  prompt       String
  status       TaskStatus    @default(QUEUED)
  currentAgent AgentRole?
  attempts     Int           @default(0)
  maxAttempts  Int           @default(5)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actions      AgentAction[]
  logs         AgentLog[]
  executions   Execution[]
}

model AgentAction {
  id        String    @id @default(cuid())
  taskId    String
  agent     AgentRole
  type      String
  path      String?
  payload   Json?
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AgentLog {
  id        String    @id @default(cuid())
  taskId    String
  agent     AgentRole?
  level     String
  message   String
  metadata  Json?
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Execution {
  id         String     @id @default(cuid())
  projectId  String?
  taskId     String?
  command    String
  exitCode   Int
  stdout     String?
  stderr     String?
  durationMs Int?
  createdAt  DateTime   @default(now())
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model UsageLog {
  id               String        @id @default(cuid())
  userId           String
  projectId        String?
  provider         ModelProvider
  model            String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  costCents        Int           @default(0)
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Billing {
  id                   String        @id @default(cuid())
  userId               String        @unique
  plan                 String        @default("starter")
  status               BillingStatus @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModelConfig {
  id              String        @id @default(cuid())
  userId          String
  provider        ModelProvider
  name            String
  baseUrl         String?
  encryptedApiKey String?
  model           String
  tokenLimit      Int           @default(128000)
  dailyLimitCents Int           @default(0)
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ── Brain v2 tables ───────────────────────────────────────────────────────────

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model ProjectContext {
  id          String   @id @default(cuid())
  userId      String
  projectName String
  summary     String?  @db.Text
  recentFiles Json?
  recentEdits Json?
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, projectName])
  @@index([userId])
}

model ConversationSummary {
  id             String   @id @default(cuid())
  userId         String
  conversationId String   @unique
  summary        String   @db.Text
  messageCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}
