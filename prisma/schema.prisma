generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DEPLOYING
  FAILED
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum AgentRole {
  PLANNER
  ARCHITECT
  CODER
  TESTER
  REVIEWER
  DEVOPS
}

enum ModelProvider {
  OLLAMA
  OPENAI
  DEEPSEEK
  ANTHROPIC
  OPENROUTER
  CUSTOM_OPENAI_COMPATIBLE
}

enum BillingStatus {
  FREE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserPlanStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum UsageWindowType {
  FIVE_HOUR
  WEEKLY
  MONTHLY
}

enum CreditTransactionType {
  USAGE
  GRANT
  RESET
  REFUND
  ADMIN_ADJUSTMENT
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum PaymentProvider {
  MANUAL
  STRIPE
  RAZORPAY
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  FAILED
  VOID
  REFUNDED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?
  role           Role            @default(USER)
  authProvider   String          @default("email")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  conversations  Conversation[]
  tasks          Task[]
  usageLogs      UsageLog[]
  billing        Billing?
  modelConfigs   ModelConfig[]
  auditLogs      AuditLog[]
  accounts       Account[]
  sessions       Session[]
  extensionTokens ExtensionToken[]
  extensionDeviceCodes ExtensionDeviceCode[]
  workspaceProjects WorkspaceProject[]
  workspaceFiles WorkspaceFile[]
  workspaceTasks WorkspaceTask[]
  workspaceRuns WorkspaceRun[]
  workspaceDiffs WorkspaceDiff[]
  workspacePreviews WorkspacePreview[]
  workspaceLogs WorkspaceLog[]
  workspaceTaskEvents WorkspaceTaskEvent[]
  workspaceSnapshots WorkspaceSnapshot[]
  userPlans UserPlan[]
  usageWindows UsageWindow[]
  creditTransactions CreditTransaction[]
  upgradeRequests UpgradeRequest[]
  userNotifications UserNotification[]
  subscriptions Subscription[]
  paymentEvents PaymentEvent[]
  invoices Invoice[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  email      String
  token      String   @unique
  expires    DateTime

  @@unique([email, token])
}

model Project {
  id             String          @id @default(cuid())
  userId         String
  name           String
  slug           String
  description    String?
  template       String?
  repositoryUrl  String?
  workspacePath  String
  status         ProjectStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  files          File[]
  conversations  Conversation[]
  tasks          Task[]
  executions     Execution[]
  usageLogs      UsageLog[]

  @@unique([userId, slug])
  @@index([userId, status])
}

model File {
  id          String   @id @default(cuid())
  projectId   String
  path        String
  contentHash String?
  language    String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model Conversation {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  provider    String?
  model       String?
  activeBrain String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([userId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  model          String?
  brain          String?
  sourcesJson    Json?
  metadataJson   Json?
  tokenCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Task {
  id           String        @id @default(cuid())
  userId       String
  projectId    String?
  title        String
  prompt       String
  status       TaskStatus    @default(QUEUED)
  currentAgent AgentRole?
  attempts     Int           @default(0)
  maxAttempts  Int           @default(5)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actions      AgentAction[]
  logs         AgentLog[]
  executions   Execution[]
}

model AgentAction {
  id        String    @id @default(cuid())
  taskId    String
  agent     AgentRole
  type      String
  path      String?
  payload   Json?
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AgentLog {
  id        String    @id @default(cuid())
  taskId    String
  agent     AgentRole?
  level     String
  message   String
  metadata  Json?
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Execution {
  id         String     @id @default(cuid())
  projectId  String?
  taskId     String?
  command    String
  exitCode   Int
  stdout     String?
  stderr     String?
  durationMs Int?
  createdAt  DateTime   @default(now())
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model UsageLog {
  id               String        @id @default(cuid())
  userId           String
  projectId        String?
  provider         ModelProvider
  model            String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  costCents        Int           @default(0)
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Billing {
  id                   String        @id @default(cuid())
  userId               String        @unique
  plan                 String        @default("starter")
  status               BillingStatus @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  description        String?
  priceMonthly       Int         @default(0)
  priceYearly        Int         @default(0)
  currency           String      @default("USD")
  monthlyCredits     Int         @default(0)
  weeklyCredits      Int         @default(0)
  fiveHourCredits    Int         @default(0)
  maxContextTokens   Int         @default(128000)
  maxWorkspaceCount  Int         @default(3)
  maxStorageMb       Int         @default(500)
  maxParallelTasks   Int         @default(1)
  priorityLevel      Int         @default(1)
  allowedModelsJson  Json?
  featuresJson       Json?
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  razorpayPlanIdMonthly String?
  razorpayPlanIdYearly  String?
  paymentEnabled     Boolean     @default(false)
  trialDays          Int         @default(0)
  yearlyDiscount     Int         @default(0)
  isActive           Boolean     @default(true)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  userPlans          UserPlan[]
  usageWindows       UsageWindow[]
  creditTransactions CreditTransaction[]
  upgradeRequestsFrom UpgradeRequest[] @relation("UpgradeRequestCurrentPlan")
  upgradeRequestsTo   UpgradeRequest[] @relation("UpgradeRequestRequestedPlan")
  subscriptions      Subscription[]
  invoices           Invoice[]

  @@index([isActive, sortOrder])
  @@index([priorityLevel])
}

model UserPlan {
  id              String         @id @default(cuid())
  userId          String
  planId          String
  status          UserPlanStatus @default(ACTIVE)
  startsAt        DateTime       @default(now())
  endsAt          DateTime?
  assignedByAdmin Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([planId])
  @@index([startsAt, endsAt])
}

model UsageWindow {
  id           String          @id @default(cuid())
  userId       String
  planId       String
  windowType   UsageWindowType
  creditsUsed  Int             @default(0)
  creditsLimit Int             @default(0)
  startsAt     DateTime
  endsAt       DateTime
  resetAt      DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([userId, windowType, startsAt])
  @@index([userId, windowType, resetAt])
  @@index([planId])
}

model CreditTransaction {
  id           String                @id @default(cuid())
  userId       String
  planId       String
  type         CreditTransactionType
  credits      Int
  reason       String?
  metadataJson Json?
  createdAt    DateTime              @default(now())
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([planId])
  @@index([type])
}

model ModelUsageConfig {
  id                        String   @id @default(cuid())
  provider                  String
  model                     String
  inputCreditMultiplier     Float    @default(1)
  outputCreditMultiplier    Float    @default(2)
  reasoningCreditMultiplier Float    @default(3)
  cachedCreditMultiplier    Float    @default(0.25)
  toolCallCreditCost        Float    @default(1)
  previewCreditCost         Float    @default(2)
  fileReadCreditCost        Float    @default(0.2)
  fileWriteCreditCost       Float    @default(1)
  memoryReadCreditCost      Float    @default(0.2)
  memoryWriteCreditCost     Float    @default(0.5)
  fallbackEstimateCredits   Int      @default(15)
  retryMultiplier           Float    @default(1.25)
  autofixMultiplier         Float    @default(1.5)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([provider, model])
  @@index([provider, isActive])
  @@index([model])
}

model UpgradeRequest {
  id            String               @id @default(cuid())
  userId        String
  currentPlanId String?
  requestedPlanId String
  status        UpgradeRequestStatus @default(PENDING)
  message       String?
  adminNote     String?
  reviewedBy    String?
  reviewedAt    DateTime?
  expiresAt     DateTime?
  bonusCredits  Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentPlan   Plan?                @relation("UpgradeRequestCurrentPlan", fields: [currentPlanId], references: [id], onDelete: SetNull)
  requestedPlan Plan                 @relation("UpgradeRequestRequestedPlan", fields: [requestedPlanId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([requestedPlanId])
  @@index([createdAt])
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  provider               PaymentProvider
  providerCustomerId     String?
  providerSubscriptionId String?
  status                 SubscriptionStatus @default(INCOMPLETE)
  billingCycle           BillingCycle       @default(MONTHLY)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices               Invoice[]

  @@index([userId, status])
  @@index([provider, providerSubscriptionId])
  @@index([planId])
}

model PaymentEvent {
  id              String             @id @default(cuid())
  userId          String?
  provider        PaymentProvider
  type            String
  status          PaymentEventStatus @default(RECEIVED)
  amount          Int?
  currency        String?
  providerEventId String?
  metadataJson    Json?
  createdAt       DateTime           @default(now())
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([userId, createdAt])
  @@index([provider, type])
}

model Invoice {
  id                 String        @id @default(cuid())
  userId             String
  planId             String?
  subscriptionId     String?
  provider           PaymentProvider
  providerInvoiceId  String?
  amount             Int
  currency           String
  status             InvoiceStatus @default(OPEN)
  hostedInvoiceUrl   String?
  invoicePdf         String?
  metadataJson       Json?
  createdAt          DateTime      @default(now())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([provider, providerInvoiceId])
}

model ModelConfig {
  id              String        @id @default(cuid())
  userId          String
  provider        ModelProvider
  name            String
  baseUrl         String?
  encryptedApiKey String?
  model           String
  tokenLimit      Int           @default(128000)
  dailyLimitCents Int           @default(0)
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ── Brain v2 tables ───────────────────────────────────────────────────────────

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model ProjectContext {
  id          String   @id @default(cuid())
  userId      String
  projectName String
  summary     String?  @db.Text
  recentFiles Json?
  recentEdits Json?
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, projectName])
  @@index([userId])
}

model ConversationSummary {
  id             String   @id @default(cuid())
  userId         String
  conversationId String   @unique
  summary        String   @db.Text
  messageCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ── Master Admin Control Center ───────────────────────────────────────────────

model SystemSetting {
  id             String   @id @default(cuid())
  key            String   @unique
  valueEncrypted String?  @db.Text
  valueMasked    String?
  category       String   @default("general")
  isSecret       Boolean  @default(false)
  requireRestart Boolean  @default(false)
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([category])
}

model SystemSettingAudit {
  id         String   @id @default(cuid())
  key        String
  action     String
  oldMasked  String?
  newMasked  String?
  updatedBy  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([key, createdAt])
  @@index([updatedBy])
}

// ── VS Code Extension Token ───────────────────────────────────────────────────

model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  tokenPrefix String?
  tokenLast4 String?
  scopesJson Json?
  name       String    @default("VS Code Extension")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model ExtensionDeviceCode {
  id          String    @id @default(cuid())
  userId      String?
  deviceCode  String    @unique
  userCode    String    @unique
  tokenPlain  String?   @db.Text
  status      String    @default("pending")
  expiresAt   DateTime
  approvedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userCode])
  @@index([deviceCode])
  @@index([expiresAt])
}

// ── AI Workspace ─────────────────────────────────────────────────────────────

model WorkspaceProject {
  id            String              @id @default(cuid())
  userId        String
  name          String
  slug          String
  description   String?
  storagePath   String
  status        String              @default("ACTIVE")
  qualityScore  Int                 @default(0)
  lastPreviewUrl String?
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  files         WorkspaceFile[]
  tasks         WorkspaceTask[]
  runs          WorkspaceRun[]
  diffs         WorkspaceDiff[]
  previews      WorkspacePreview[]
  logs          WorkspaceLog[]
  events        WorkspaceTaskEvent[]
  snapshots     WorkspaceSnapshot[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@index([status])
}

model WorkspaceFile {
  id         String           @id @default(cuid())
  userId     String
  projectId  String
  path       String
  status     String           @default("UNCHANGED")
  language   String?
  sizeBytes  Int              @default(0)
  contentHash String?
  changed    Boolean          @default(false)
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    WorkspaceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([userId, updatedAt])
  @@index([projectId, status])
  @@index([projectId, deletedAt])
}

model WorkspaceTask {
  id            String             @id @default(cuid())
  userId        String
  projectId     String
  prompt        String             @db.Text
  planJson      Json?
  status        String             @default("QUEUED")
  summary       String?            @db.Text
  qualityScore  Int                @default(0)
  previewUrl    String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       WorkspaceProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs          WorkspaceRun[]
  diffs         WorkspaceDiff[]
  previews      WorkspacePreview[]
  logs          WorkspaceLog[]
  events        WorkspaceTaskEvent[]
  snapshots     WorkspaceSnapshot[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
}

model WorkspaceRun {
  id          String            @id @default(cuid())
  userId      String
  projectId   String
  taskId      String?
  command     String
  status      String            @default("PENDING")
  exitCode    Int?
  stdout      String?           @db.Text
  stderr      String?           @db.Text
  durationMs  Int?
  previewUrl  String?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     WorkspaceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        WorkspaceTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId])
}

model WorkspaceDiff {
  id          String          @id @default(cuid())
  userId      String
  projectId   String
  taskId      String
  path        String
  operation   String
  added       Int             @default(0)
  removed     Int             @default(0)
  oldContent  String?         @db.Text
  newContent  String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     WorkspaceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        WorkspaceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([path])
}

model WorkspacePreview {
  id            String            @id @default(cuid())
  userId        String
  projectId     String
  taskId        String?
  url           String
  port          Int?
  status        String            @default("STARTING")
  httpStatus    Int?
  verified      Boolean           @default(false)
  message       String?
  logs          Json?
  lastCheckedAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       WorkspaceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          WorkspaceTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId])
}

model WorkspaceLog {
  id          String             @id @default(cuid())
  userId      String?
  projectId   String
  taskId      String?
  level       String             @default("info")
  event       String
  message     String
  metadata    Json?
  createdAt   DateTime           @default(now())
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  project     WorkspaceProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        WorkspaceTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([userId])
}

model WorkspaceTaskEvent {
  id          String          @id @default(cuid())
  userId      String
  taskId      String
  projectId   String
  sequence    Int
  type        String
  message     String
  payloadJson Json?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        WorkspaceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project     WorkspaceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([taskId, sequence])
  @@index([userId, createdAt])
  @@index([taskId, sequence])
  @@index([projectId, createdAt])
}

model WorkspaceSnapshot {
  id           String            @id @default(cuid())
  userId       String
  projectId    String
  taskId       String?
  label        String?
  snapshotJson Json
  fileCount    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      WorkspaceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         WorkspaceTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId])
}
