{
  "name": "meldex-ai",
  "displayName": "Meldex AI",
  "description": "Codex-style AI coding assistant with chat, agent timeline, diff review, patch apply, and terminal checks.",
  "version": "5.1.2",
  "publisher": "meldex-ai",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sumitsavani007/Meldex-AI"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "copilot",
    "agent",
    "chat",
    "meldex",
    "coding assistant",
    "diff",
    "codex",
    "qwen"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "bin": {
    "meldex-agent": "./out/cli/main.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "meldex-sidebar",
          "title": "Meldex AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "meldex-sidebar": [
        {
          "type": "webview",
          "id": "meldex-ai.chatView",
          "name": "Meldex AI",
          "icon": "media/icon.svg",
          "contextualTitle": "Meldex AI"
        }
      ]
    },
    "commands": [
      {
        "command": "meldex-ai.openChat",
        "title": "Meldex: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "meldex-ai.repairInstallation",
        "title": "Meldex: Repair Agent Installation"
      },
      {
        "command": "meldex-ai.doctor",
        "title": "Meldex: Doctor"
      },
      {
        "command": "meldex-ai.explainSelection",
        "title": "Meldex: Explain Selection"
      },
      {
        "command": "meldex-ai.fixFile",
        "title": "Meldex: Fix Current File"
      },
      {
        "command": "meldex-ai.generateTests",
        "title": "Meldex: Generate Tests"
      },
      {
        "command": "meldex-ai.refactorSelection",
        "title": "Meldex: Refactor Selection"
      },
      {
        "command": "meldex-ai.runAgent",
        "title": "Meldex: Run Agent"
      },
      {
        "command": "meldex-ai.copyBenchmarkToken",
        "title": "Meldex: Copy Benchmark Token"
      },
      {
        "command": "meldex-ai.logout",
        "title": "Meldex: Logout"
      },
      {
        "command": "meldex-ai.addDocs",
        "title": "Meldex: Add Documentation"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "meldex-ai.explainSelection",
          "group": "meldex@1",
          "when": "editorHasSelection"
        },
        {
          "command": "meldex-ai.fixFile",
          "group": "meldex@2"
        },
        {
          "command": "meldex-ai.refactorSelection",
          "group": "meldex@3",
          "when": "editorHasSelection"
        },
        {
          "command": "meldex-ai.generateTests",
          "group": "meldex@4"
        },
        {
          "command": "meldex-ai.addDocs",
          "group": "meldex@5"
        }
      ],
      "explorer/context": [
        {
          "command": "meldex-ai.explainSelection",
          "group": "meldex@1"
        },
        {
          "command": "meldex-ai.fixFile",
          "group": "meldex@2"
        },
        {
          "command": "meldex-ai.generateTests",
          "group": "meldex@3"
        }
      ]
    },
    "configuration": {
      "title": "Meldex AI",
      "properties": {
        "meldex.apiUrl": {
          "type": "string",
          "default": "https://meldex.newsyfly.com",
          "description": "Meldex AI backend URL"
        },
        "meldex.autoApplyChanges": {
          "type": "boolean",
          "default": false,
          "description": "Auto-apply agent changes without confirmation"
        },
        "meldex.safeTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Block dangerous terminal commands"
        },
        "meldex.includeGitIgnoredFiles": {
          "type": "boolean",
          "default": false,
          "description": "Include .gitignore'd files in context"
        },
        "meldex.maxFilesToSend": {
          "type": "number",
          "default": 20,
          "description": "Max files to include in agent context"
        },
        "meldex.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit Node.js runtime path. Leave empty to use a safe runtime from process.execPath or PATH."
        },
        "meldex.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit Meldex Agent CLI JavaScript path. Bundled CLI is used first."
        },
        "meldex.qwenTemperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Qwen3-Coder temperature hint for coding tasks"
        },
        "meldex.qwenMaxTokens": {
          "type": "number",
          "default": 8192,
          "description": "Qwen3-Coder max output token hint"
        },
        "meldex.qwenTimeoutMs": {
          "type": "number",
          "default": 90000,
          "description": "Qwen3-Coder request timeout in milliseconds"
        },
        "meldex.qwenRetryCount": {
          "type": "number",
          "default": 2,
          "description": "Retries for malformed or weak action JSON"
        },
        "meldex.qwenContextSize": {
          "type": "number",
          "default": 24000,
          "description": "Maximum optimized context characters sent to Qwen3-Coder"
        },
        "meldex.qwenActionMode": {
          "type": "boolean",
          "default": true,
          "description": "Ask Qwen3-Coder for structured action JSON in Agent Mode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/ensure-cli-bin.js",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
